<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_gradient_background"
    android:fillViewport="true"
    android:paddingBottom="160dp"
    android:clipToPadding="false"
    tools:context=".ui.auth.SignUpFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/auth_card_background"
        android:padding="32dp">

        <!-- User Icon with Plus -->
        <ImageView
            android:id="@+id/imageViewUserIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/avatar_gradient_background"
            android:padding="16dp"
            android:src="@drawable/ic_person"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/textViewCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/join_our_community"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imageViewUserIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_sharing_borrowing"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/textViewCreateAccount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Error Message -->
        <TextView
            android:id="@+id/textViewError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/airbnb_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/error_background"
            android:visibility="gone"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/textViewSubtitle" />

        <!-- Divider -->
        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/textViewError" />

        <!-- Account Information Section -->
        <ImageView
            android:id="@+id/imageViewAccountIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_person"
            app:tint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textViewAccountSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/account_information"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/imageViewAccountIcon"
            app:layout_constraintBottom_toBottomOf="@id/imageViewAccountIcon"
            app:layout_constraintStart_toEndOf="@id/imageViewAccountIcon" />

        <!-- Username Label -->
        <TextView
            android:id="@+id/textViewUsernameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/username"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/textViewAccountSection"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Username Input -->
        <EditText
            android:id="@+id/editTextUsername"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/username"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textViewUsernameLabel" />

        <!-- Email Label -->
        <TextView
            android:id="@+id/textViewEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/editTextUsername"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Email Input -->
        <EditText
            android:id="@+id/editTextEmail"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textViewEmailLabel" />

        <!-- Password Label -->
        <TextView
            android:id="@+id/textViewPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/editTextEmail"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Password Input -->
        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textViewPasswordLabel" />

        <!-- Divider -->
        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/editTextPassword" />

        <!-- Address Information Section -->
        <ImageView
            android:id="@+id/imageViewAddressIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_home_black_24dp"
            app:tint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textViewAddressSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/address_information"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/imageViewAddressIcon"
            app:layout_constraintBottom_toBottomOf="@id/imageViewAddressIcon"
            app:layout_constraintStart_toEndOf="@id/imageViewAddressIcon" />

        <!-- Street Address Label -->
        <TextView
            android:id="@+id/textViewStreetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/street_address"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/textViewAddressSection"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Street Address Input -->
        <EditText
            android:id="@+id/editTextStreetAddress"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/street_address"
            android:inputType="textPostalAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textViewStreetLabel" />

        <!-- City and State Row -->
        <TextView
            android:id="@+id/textViewCityLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/city"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/editTextStreetAddress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textViewStateLabel" />

        <TextView
            android:id="@+id/textViewStateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/state"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/textViewCityLabel"
            app:layout_constraintBottom_toBottomOf="@id/textViewCityLabel"
            app:layout_constraintStart_toEndOf="@id/textViewCityLabel"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- City and State Inputs -->
        <EditText
            android:id="@+id/editTextCity"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/city"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textViewCityLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/editTextState" />

        <EditText
            android:id="@+id/editTextState"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/state"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="@id/editTextCity"
            app:layout_constraintBottom_toBottomOf="@id/editTextCity"
            app:layout_constraintStart_toEndOf="@id/editTextCity"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ZIP Code and Phone Row -->
        <TextView
            android:id="@+id/textViewZipLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/zip_code"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/editTextCity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textViewPhoneLabel" />

        <TextView
            android:id="@+id/textViewPhoneLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/phone"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/textViewZipLabel"
            app:layout_constraintBottom_toBottomOf="@id/textViewZipLabel"
            app:layout_constraintStart_toEndOf="@id/textViewZipLabel"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ZIP Code and Phone Inputs -->
        <EditText
            android:id="@+id/editTextZipCode"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/zip_code"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textViewZipLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/editTextPhone" />

        <EditText
            android:id="@+id/editTextPhone"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/auth_input_background"
            android:hint="@string/phone"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/airbnb_black"
            android:textColorHint="#999999"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="@id/editTextZipCode"
            app:layout_constraintBottom_toBottomOf="@id/editTextZipCode"
            app:layout_constraintStart_toEndOf="@id/editTextZipCode"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sign Up Button -->
        <Button
            android:id="@+id/buttonSignUp"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/create_account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/airbnb_black"
            android:layout_marginTop="32dp"
            android:background="@drawable/auth_primary_button_background"
            app:layout_constraintTop_toBottomOf="@id/editTextZipCode" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/buttonSignUp"
            app:layout_constraintBottom_toBottomOf="@id/buttonSignUp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sign In Link -->
        <TextView
            android:id="@+id/textViewSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/already_have_account_sign_in"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonSignUp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView> 